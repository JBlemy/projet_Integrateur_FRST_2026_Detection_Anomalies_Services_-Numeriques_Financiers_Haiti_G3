    "\"\"\"\n",
    "    Cette section execute les regles de nettoyage definies :\n",
    "\n",
    "    8.1. SUPPRESSION DES DOUBLONS :\n",
    "        - Suppression des lignes strictement identiques\n",
    "        - Tracabilite du nombre de lignes supprimees\n",
    "\n",
    "    8.2. GESTION DES VALEURS MANQUANTES:\n",
    "        - Imputation des valeurs manquantes\n",
    "        - Journalisation des decisions\n",
    "\n",
    "    8.3. CORRECTION DES TYPES :\n",
    "        - Conversion des dates en datetime\n",
    "        - Maintien des types appropries\n",
    "\n",
    "    8.4. TRAITEMENT DES VALEURS EXTREMES :\n",
    "        - Conservation des montants geants\n",
    "        - Bornage (clipping) si necessaire\n",
    "\n",
    "    8.5. SAUVEGARDE:\n",
    "        - Fichier nettoye : ../data/processed/indian_banking_transactions_clean.csv\n",
    "        - Journal des operations: ../data/processed/cleaning_log.txt\n",
    "\"\"\"\n",
    "\n",
    "def execute_cleaning(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Exécute le nettoyage selon les règles définies.\n",
    "    \n",
    "    Parameters\n",
    "    ----------\n",
    "    df : pd.DataFrame\n",
    "        DataFrame brut à nettoyer\n",
    "        \n",
    "    Returns\n",
    "    -------\n",
    "    pd.DataFrame\n",
    "        DataFrame nettoyé\n",
    "        \n",
    "    Notes\n",
    "    -----\n",
    "    Cette fonction applique les règles de nettoyage définies dans la section 7.\n",
    "    Toutes les opérations sont journalisées pour la traçabilité.\n",
    "    \"\"\"\n",
    "\n",
    "    print(\"\\n\" + \"=\"*60)\n",
    "    print(\"8. EXECUTION DU NETTOYAGE\")\n",
    "    print(\"=\"*60)\n",
    "    \n",
    "    # Copie profonde pour éviter les avertissements de type SettingWithCopyWarning\n",
    "    df_clean = df.copy()\n",
    "    \n",
    "    # Journal des opérations\n",
    "    cleaning_log = []\n",
    "    \n",
    "    # 8.1. Suppression des doublons\n",
    "    print(\"\\n8.1 SUPPRESSION DES DOUBLONS :\")\n",
    "    duplicates_before = df_clean.duplicated().sum()\n",
    "    if duplicates_before > 0:\n",
    "        df_clean = df_clean.drop_duplicates()\n",
    "        duplicates_after = df_clean.duplicated().sum()\n",
    "        removed = duplicates_before - duplicates_after\n",
    "        print(f\"   Doublons supprimés : {removed:,}\")\n",
    "        cleaning_log.append(f\"Doublons supprimés : {removed} lignes\")\n",
    "    else:\n",
    "        print(\"   Aucun doublon à supprimer\")\n",
    "    \n",
    "    # 8.2. Gestion des valeurs manquantes\n",
    "    print(\"\\n8.2 GESTION DES VALEURS MANQUANTES :\")\n",
    "    missing_before = df_clean.isnull().sum().sum()\n",
    "\n",
    "    if missing_before > 0:\n",
    "        for col in df_clean.columns:\n",
    "            if df_clean[col].isnull().any():\n",
    "                # Vérifier si la colonne est numérique\n",
    "                if pd.api.types.is_numeric_dtype(df_clean[col]):\n",
    "                    # Calculer la médiane (ignore les NaN)\n",
    "                    median_val = df_clean[col].median(skipna=True)\n",
    "                    df_clean[col] = df_clean[col].fillna(median_val)\n",
    "                    print(f\"   {col} : Remplacé par médiane ({median_val:.2f})\")\n",
    "                    cleaning_log.append(f\"{col}: médiane ({median_val:.2f})\")\n",
    "                else:\n",
    "                    # Colonne catégorielle => remplacer par \"Unknown\"\n",
    "                    df_clean[col] = df_clean[col].fillna('Unknown')\n",
    "                    print(f\"   {col} : Remplacé par 'Unknown' (catégoriel)\")\n",
    "                    cleaning_log.append(f\"{col}: 'Unknown' pour valeurs manquantes\")\n",
    "    else:\n",
    "        print(\"   Aucune valeur manquante à traiter\")\n",
    "        \n",
    "    # 8.3. Correction des types\n",
    "    print(\"\\n8.3 CORRECTION DES TYPES :\")\n",
    "    for col in df_clean.columns:\n",
    "        if df_clean[col].dtype == 'object':\n",
    "            if col == 'transaction_date':\n",
    "                # transaction_date : convertir en datetime puis extraire la date\n",
    "                df_clean[col] = pd.to_datetime(df_clean[col]).dt.date\n",
    "                print(f\"   {col} : Converti en format Date\")\n",
    "                cleaning_log.append(f\"{col}: converti en date\")\n",
    "            elif col == 'transaction_time':\n",
    "                # transaction_time : extraire uniquement l'heure\n",
    "                # Note: Si c'est juste une chaîne \"HH:MM:SS\", on la convertit proprement\n",
    "                try:\n",
    "                    df_clean[col] = pd.to_datetime(df_clean[col], format='%H:%M:%S').dt.time\n",
    "                except:\n",
    "                    df_clean[col] = pd.to_datetime(df_clean[col]).dt.time\n",
    "                print(f\"   {col} : Extrait au format Time uniquement\")\n",
    "                cleaning_log.append(f\"{col}: extraire l'heure\")\n",
    "            else:\n",
    "                try:\n",
    "                    df_clean[col] = pd.to_datetime(df_clean[col])\n",
    "                    print(f\"   {col} : Converti en datetime\")\n",
    "                    cleaning_log.append(f\"{col}: converti en datetime\")\n",
    "                except:\n",
    "                    # Conversion en catégorie pour optimiser la mémoire si le nombre de valeurs uniques est faible\n",
    "                    if df_clean[col].nunique() < 100:\n",
    "                        df_clean[col] = df_clean[col].astype('category')\n",
    "                        print(f\"   {col} : Converti en format Catégoriel (optimisation)\")\n",
    "                    else:\n",
    "                        print(f\"   {col} : Maintien en format texte (object)\")\n",
    "    \n",
    "    # 8.4. Traitement des valeurs extrêmes (MAINTIEN)\n",
    "    print(\"\\n8.4 TRAITEMENT DES VALEURS EXTREMES :\")\n",
    "    print(\"   PRINCIPE: Maintien des montants géants pour l'apprentissage non supervisé\")\n",
    "    print(\"   JUSTIFICATION: Les anomalies financières recherchées sont les valeurs extrêmes.\")\n",
    "    print(\"   APPROCHE COMPLÉMENTAIRE: Une transformation Log (np.log1p) sera appliquée dans le pipeline\")\n",
    "    print(\"                           de modélisation juste avant le StandardScaler.\")\n",
    "    \n",
    "    numeric_cols = df_clean.select_dtypes(include=[np.number]).columns\n",
    "    for col in numeric_cols:\n",
    "        # Exclusion des variables ID ou heure qui n'ont pas de sens pour le calcul statistique de dispersion\n",
    "        if 'id' in col.lower() or 'hour' in col.lower() or 'has_' in col.lower():\n",
    "            continue\n",
    "            \n",
    "        mean_val = df_clean[col].mean()\n",
    "        std_val = df_clean[col].std()\n",
    "        \n",
    "        # Calcul des limites théoriques (Z-score = 3)\n",
    "        lower_bound = mean_val - 3 * std_val\n",
    "        upper_bound = mean_val + 3 * std_val\n",
    "        \n",
    "        # Identification statistique sans suppression\n",
    "        outliers_count = ((df_clean[col] < lower_bound) | (df_clean[col] > upper_bound)).sum()\n",
    "        pct_outliers = (outliers_count / len(df_clean)) * 100\n",
    "        \n",
    "        print(f\"   {col} : {outliers_count:,} valeurs hors limites [3 Sigma] ({pct_outliers:.2f}%) -> CONSERVÉES\")\n",
    "        cleaning_log.append(f\"{col}: {outliers_count} outliers conservés\")\n",
    "\n",
    "    # 8.5. Sauvegarde du fichier nettoyé et du journal\n",
    "    print(\"\\n8.5 SAUVEGARDE DES RÉSULTATS :\")\n",
    "    OUTPUT_CLEAN_PATH = '../data/processed/indian_banking_transactions_clean.csv'\n",
    "    LOG_PATH = '../data/processed/cleaning_log.txt'\n",
    "    \n",
    "    # Création des dossiers parents si inexistants\n",
    "    os.makedirs(os.path.dirname(OUTPUT_CLEAN_PATH), exist_ok=True)\n",
    "    \n",
    "    df_clean.to_csv(OUTPUT_CLEAN_PATH, index=False, encoding='utf-8')\n",
    "    print(f\"   Fichier nettoyé sauvegardé : '{OUTPUT_CLEAN_PATH}'\")\n",
    "    print(f\"   Dimensions finales : {df_clean.shape[0]:,} lignes x {df_clean.shape[1]} colonnes\")\n",
    "    \n",
    "    with open(LOG_PATH, 'w', encoding='utf-8') as f:\n",
    "        f.write(\"JOURNAL DE NETTOYAGE DES DONNEES (CLEANING LOG)\\n\")\n",
    "        f.write(\"=\"*50 + \"\\n\")\n",
    "        f.write(f\"Date d'exécution : {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\\n\")\n",
    "        f.write(f\"Volume initial : {len(df):,} lignes\\n\")\n",
    "        f.write(f\"Volume final   : {len(df_clean):,} lignes\\n\\n\")\n",
    "        f.write(\"Détails des opérations :\\n\")\n",
    "        for log in cleaning_log:\n",
    "            f.write(f\" - {log}\\n\")\n",
    "            \n",
    "    print(f\"   Journal des opérations sauvegardé : '{LOG_PATH}'\")\n",
    "    \n",
    "    return df_clean\n",
    "\n",
    "# Exécution effective du pipeline de nettoyage\n",
    "try:\n",
    "    df_clean = execute_cleaning(df)\n",
    "except Exception as e:\n",
    "    print(f\"\\n[ERREUR] Échec lors de l'exécution du nettoyage : {str(e)}\")\n",
    "\n",
    "# Sauvegarde des donnees nettoyees\n",
    "df_clean.to_csv('../data/processed/indian_banking_transactions_clean.csv', index=False)\n",
    "print(\"\\nDonnees nettoyees sauvegardees: '../data/processed/indian_banking_transactions_clean.csv'\")"
   ]
  },
