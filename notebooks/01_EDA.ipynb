    "            \n",
    "            # Sauvegarde\n",
    "            df[col].value_counts().to_csv(f'../results/metrics/{col}_distribution.csv')\n",
    "            print(f\"   Sauvegarde: '../results/metrics/{col}_distribution.csv'\")\n",
    "\n",
    "descriptive_analysis(df_clean)"
   ]
