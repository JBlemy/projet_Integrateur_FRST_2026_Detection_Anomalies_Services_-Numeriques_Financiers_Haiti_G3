    "# Constantes de configuration\n",
    "PALETTE_FRAUDE = {0: \"#95a5a6\", 1: \"#e74c3c\", \"0\": \"#95a5a6\", \"1\": \"#e74c3c\"}\n",
    "\n",
    "\n",
    "# ==============================================================================\n",
    "# FUNCTION 1 : ANALYSE TOPOLOGIQUE\n",
    "# ==============================================================================\n",
    "\n",
    "\"\"\"\n",
    "    Cette section analyse l'espace géométrique des transactions :\n",
    "\n",
    "        1.1. DISTRIBUTION JOINTE (SCATTER PLOT):\n",
    "            - Projection des variables transaction_hour (X) et transaction_amount (Y)\n",
    "            - Coloration conditionnelle basée sur le vecteur cible is_fraud\n",
    "\n",
    "        1.2. ISOLEMENT TOPOLOGIQUE:\n",
    "            - Évaluation visuelle de la séparabilité des classes\n",
    "            - Validation empirique de l'hypothèse d'isolation (fondement d'Isolation Forest)\n",
    "\"\"\"\n",
    "\n",
    "\n",
    "def plot_topological_isolation(df: pd.DataFrame) -> None:\n",
    "    \"\"\"\n",
    "    Génère une analyse topologique bidimensionnelle pour évaluer l'isolement\n",
    "    spatial des anomalies financières par rapport au flux de masse.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    df : pd.DataFrame\n",
    "        DataFrame contenant les données transactionnelles nettoyées.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    None\n",
    "        Le graphique est affiché et sauvegardé sous format PNG haute résolution.\n",
    "\n",
    "    Notes\n",
    "    -----\n",
    "    Cette fonction produit :\n",
    "        - Un nuage de points (Scatter Plot) Heure vs Montant.\n",
    "        - Une mise en évidence des ruptures statistiques comportementales.\n",
    "        - Sauvegarde sous : '../results/figures/topological_isolation.png'\n",
    "    \"\"\"\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"1. ANALYSE TOPOLOGIQUE : DISTRIBUTION JOINTE\")\n",
    "    print(\"=\" * 60)\n",
    "\n",
    "    # 1.1. Explications théoriques et structurelles\n",
    "    print(\"\\n1.1. SIGNATURE GÉOMÉTRIQUE DE LA FRAUDE:\")\n",
    "    print(\"-\" * 40)\n",
    "    print(\"La détection d'anomalies repose sur deux propriétés mathématiques :\")\n",
    "    print(\"  - Rareté : Les fraudes représentent une fraction minoritaire des flux.\")\n",
    "    print(\n",
    "        \"  - Écartement : Les caractéristiques de fraude s'isolent dans l'espace.\"\n",
    "    )\n",
    "\n",
    "    # Sécurisation du typage pour la légende\n",
    "    df_local = df.copy()\n",
    "    df_local[\"is_fraud\"] = df_local[\"is_fraud\"].astype(str)\n",
    "\n",
    "    # 1.2. Construction du livrable visuel\n",
    "    print(\"\\n1.2. GÉNÉRATION ET SAUVEGARDE DU GRAPHIQUE:\")\n",
    "    print(\"-\" * 40)\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(11, 6))\n",
    "\n",
    "    sns.scatterplot(\n",
    "        data=df_local,\n",
    "        x=\"transaction_hour\",\n",
    "        y=\"transaction_amount\",\n",
    "        hue=\"is_fraud\",\n",
    "        hue_order=[\"0\", \"1\"],\n",
    "        palette=PALETTE_FRAUDE,\n",
    "        alpha=0.6,\n",
    "        edgecolor=\"w\",\n",
    "        linewidth=0.5,\n",
    "        ax=ax,\n",
    "    )\n",
    "\n",
    "    ax.set_title(\n",
    "        \"Analyse Topologique : Distribution Jointe de l'Espace Transactionnel\",\n",
    "        pad=15,\n",
    "    )\n",
    "    ax.set_xlabel(\"Heure de l'opération (0 - 23h)\")\n",
    "    ax.set_ylabel(\"Montant de la transaction (Notation Scientifique)\")\n",
    "    ax.set_xticks(range(0, 24, 2))\n",
    "\n",
    "    # Restitution propre des couleurs de la palette via les handles d'origine\n",
    "    handles, _ = ax.get_legend_handles_labels()\n",
    "    ax.legend(\n",
    "        handles=handles,\n",
    "        labels=[\"Légitime (0)\", \"Fraude (1)\"],\n",
    "        title=\"Statut Décisionnel\",\n",
    "    )\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(\n",
    "        \"../results/figures/topological_isolation.png\",\n",
    "        dpi=300,\n",
    "        bbox_inches=\"tight\",\n",
    "    )\n",
    "    plt.show()\n",
    "    print(\n",
    "        \"Graphique sauvegardé avec succès: '../results/figures/topological_isolation.png'\"\n",
    "    )\n",
    "\n",
    "    # 1.3. Diagnostic\n",
    "    print(\"\\n1.3. DIAGNOSTIC ET CRITIQUE DE LA COUCHE VERTICALE (Y):\")\n",
    "    print(\"-\" * 40)\n",
    "    print(\n",
    "        f\"  - L'axe Y affiche un facteur d'échelle multiplicatif en haut à gauche (ex: 1e7).\"\n",
    "    )\n",
    "    print(\n",
    "        \"  - Cela indique une variance extrême et la présence de montants massifs.\"\n",
    "    )\n",
    "    print(\n",
    "        \"  - Le comportement confirme l'obligation d'un Feature Scaling (Normalisation)\"\n",
    "    )\n",
    "    print(\n",
    "        \"    avant le clustering pour éviter l'écrasement de la dimension horaire.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ==============================================================================\n",
    "# FUNCTION 2 : VOLUMÉTRIE PAR CANAL\n",
    "# ==============================================================================\n",
    "\n",
    "\"\"\"\n",
    "    Cette section évalue l'asymétrie de la fraude selon les canaux :\n",
    "\n",
    "        2.1. VOLUMÉTRIE ABSOLUE ET FRACTIONNÉE (BAR CHARTS):\n",
    "            - Distribution brute des flux bancaires injectés par canal d'accès\n",
    "            - Normalisation à 100% pour isoler le taux d'incidence relatif\n",
    "\n",
    "        2.2. VULNÉRABILITÉ DU CANAL:\n",
    "            - Identification des infrastructures numériques à haut risque\n",
    "\"\"\"\n",
    "\n",
    "\n",
    "def plot_categorical_risk_distribution(df: pd.DataFrame) -> None:\n",
    "    \"\"\"\n",
    "    Analyse comparative des volumes absolus et des proportions normalisées\n",
    "    de fraude pour chaque canal d'accès opérationnel (Channel).\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    df : pd.DataFrame\n",
    "        DataFrame contenant les données transactionnelles nettoyées.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    None\n",
    "        Le graphique double est affiché et sauvegardé sous format PNG.\n",
    "\n",
    "    Notes\n",
    "    -----\n",
    "    Cette fonction produit :\n",
    "        - Un countplot des volumes bruts par canal.\n",
    "        - Un diagramme à barres empilées normalisé à 100%.\n",
    "        - Sauvegarde sous : '../results/figures/categorical_risk_distribution.png'\n",
    "    \"\"\"\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"2. DISCRIMINATION ET INCIDENCE CRITIQUE PAR CANAL\")\n",
    "    print(\"=\" * 60)\n",
    "\n",
    "    print(\"\\n2.1. CALCUL DES MATRICES DE CONTINGENCE NORMALISÉES:\")\n",
    "    print(\"-\" * 40)\n",
    "\n",
    "    df_local = df.copy()\n",
    "    df_local[\"is_fraud\"] = df_local[\"is_fraud\"].astype(str)\n",
    "\n",
    "    # Calcul statistique des proportions métiers\n",
    "    contingency_pct = pd.crosstab(\n",
    "        df_local[\"channel\"], df_local[\"is_fraud\"], normalize=\"index\"\n",
    "    ) * 100\n",
    "    display(contingency_pct.round(2))\n",
    "\n",
    "    print(\"\\n2.2. GÉNÉRATION DES COMPOSANTS VISUELS (DOUBLES AXES):\")\n",
    "    print(\"-\" * 40)\n",
    "\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(15, 6))\n",
    "\n",
    "    # A. Volume Brut\n",
    "    sns.countplot(\n",
    "        data=df_local,\n",
    "        x=\"channel\",\n",
    "        hue=\"is_fraud\",\n",
    "        hue_order=[\"0\", \"1\"],\n",
    "        palette=PALETTE_FRAUDE,\n",
    "        alpha=0.8,\n",
    "        ax=axes[0],\n",
    "    )\n",
    "    axes[0].set_title(\"A. Volumétrie Globale des Flux par Canal\")\n",
    "    axes[0].set_xlabel(\"Canal d'accès\")\n",
    "    axes[0].set_ylabel(\"Nombre total de transactions\")\n",
    "    axes[0].legend(title=\"Statut\", labels=[\"Légitime\", \"Fraude\"])\n",
    "    axes[0].tick_params(axis=\"x\", rotation=15)\n",
    "\n",
    "    # B. Proportion Empilée Normalisée\n",
    "    contingency_pct.plot(\n",
    "        kind=\"bar\", stacked=True, color=[\"#95a5a6\", \"#e74c3c\"], ax=axes[1]\n",
    "    )\n",
    "    axes[1].set_title(\"B. Taux d'Incidence de la Fraude par Canal (%)\")\n",
    "    axes[1].set_xlabel(\"Canal d'accès\")\n",
    "    axes[1].set_ylabel(\"Proportion Relative (%)\")\n",
    "    axes[1].set_xticklabels(axes[1].get_xticklabels(), rotation=15)\n",
    "    axes[1].legend(title=\"Statut\", labels=[\"Légitime\", \"Fraude\"])\n",
    "\n",
    "    plt.suptitle(\n",
    "        \"Analyse Comparative et Identification des Canaux Vulnérables\", y=1.02\n",
    "    )\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(\n",
    "        \"../results/figures/categorical_risk_distribution.png\",\n",
    "        dpi=300,\n",
    "        bbox_inches=\"tight\",\n",
    "    )\n",
    "    plt.show()\n",
    "    print(\n",
    "        \"Graphique sauvegardé avec succès: '../results/figures/categorical_risk_distribution.png'\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ==============================================================================\n",
    "# FUNCTION 3 : SAISONNALITÉ HORAIRE ET SA CRITIQUE\n",
    "# ==============================================================================\n",
    "\n",
    "\"\"\"\n",
    "    Cette section audite la structure temporelle et la stationnarité :\n",
    "\n",
    "        3.1. AGRÉGATION TEMPORELLE BIVARIÉE:\n",
    "            - Comptage des transactions intersectées par tranche horaire et canal\n",
    "\n",
    "        3.2. AUDIT DE SINCÉRITÉ DE LA DONNÉE:\n",
    "            - Évaluation critique de la saisonnalité (recherche de cycles humains)\n",
    "            - Identification de biais de génération synthétique (courbes uniformes)\n",
    "\"\"\"\n",
    "\n",
    "\n",
    "def plot_hourly_activity_by_channel(df: pd.DataFrame) -> None:\n",
    "    \"\"\"\n",
    "    Analyse de la saisonnalité temporelle des flux pour détecter des variations\n",
    "    horaires cycliques par canal ou valider la linéarité statistique du dataset.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    df : pd.DataFrame\n",
    "        DataFrame contenant les données transactionnelles nettoyées.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    None\n",
    "        Le graphique linéaire est affiché et sauvegardé sous format PNG.\n",
    "\n",
    "    Notes\n",
    "    -----\n",
    "    Cette fonction produit :\n",
    "        - Un Line Plot (Série horaire agrégée) de 0h à 23h.\n",
    "        - Une critique d'intégrité de la distribution de la source de données.\n",
    "        - Sauvegarde sous : '../results/figures/hourly_seasonality_audit.png'\n",
    "    \"\"\"\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"3. AUDIT TEMPOREL ET SAISONNALITÉ DES FLUX\")\n",
    "    print(\"=\" * 60)\n",
    "\n",
    "    print(\"\\n3.1. EXTRACTION ET COMPTAGE DES INTERSECTIONS (144 SÉRIES):\")\n",
    "    print(\"-\" * 40)\n",
    "\n",
    "    # Agrégation bidimensionnelle\n",
    "    hourly_counts = (\n",
    "        df.groupby([\"transaction_hour\", \"channel\"])\n",
    "        .size()\n",
    "        .reset_index(name=\"counts\")\n",
    "    )\n",
    "    print(\n",
    "        f\"Dimensions de la matrice agrégée : {hourly_counts.shape} (24h * 6 canaux)\"\n",
    "    )\n",
    "\n",
    "    print(\"\\n3.2. TRACÉ DES SÉRIES ET DIAGNOSTIC CRITIQUE:\")\n",
    "    print(\"-\" * 40)\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(12, 6))\n",
    "\n",
    "    sns.lineplot(\n",
    "        data=hourly_counts,\n",
    "        x=\"transaction_hour\",\n",
    "        y=\"counts\",\n",
    "        hue=\"channel\",\n",
    "        marker=\"o\",\n",
    "        linewidth=2.5,\n",
    "        palette=\"Set2\",\n",
    "        ax=ax,\n",
    "    )\n",
    "\n",
    "    ax.set_title(\n",
    "        \"Saisonnalité Temporelle : Évolution Horaire Linéaire par Canal\", pad=15\n",
    "    )\n",
    "    ax.set_xlabel(\"Heure de la journée (0h - 23h)\")\n",
    "    ax.set_ylabel(\"Nombre cumulé de transactions (Volume)\")\n",
    "    ax.set_xticks(range(0, 24))\n",
    "    ax.grid(True, linestyle=\"--\", alpha=0.6)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(\n",
    "        \"../results/figures/hourly_seasonality_audit.png\",\n",
    "        dpi=300,\n",
    "        bbox_inches=\"tight\",\n",
    "    )\n",
    "    plt.show()\n",
    "    print(\n",
    "        \"Graphique sauvegardé avec succès: '../results/figures/hourly_seasonality_audit.png'\"\n",
    "    )\n",
    "\n",
    "    # 3.3. Section d'interprétation Master indispensable\n",
    "    print(\"\\n3.3. RAPPORT D'AUDIT SUR L'INTÉGRITÉ STRUCTURELLE :\")\n",
    "    print(\"-\" * 40)\n",
    "    print(\n",
    "        \"  - Observation : Les courbes d'activité horaire affichent une stationnarité parfaite (lignes plates).\"\n",
    "    )\n",
    "    print(\n",
    "        \"  - Analyse : L'absence de cycles physiologiques humains (ex: creux nocturnes à 3h du matin)\"\n",
    "    )\n",
    "    print(\n",
    "        \"    et la présence constante d'activité dans les succursales ('Branch') physiques la nuit\"\n",
    "    )\n",
    "    print(\n",
    "        \"    prouvent de manière irréfutable que ce jeu de données proxy est issu d'une génération synthétique uniforme.\"\n",
    "    )\n",
    "    print(\n",
    "        \"  - Impact Modélisation : La variable 'heure' seule n'a aucun pouvoir prédictif linéaire.\"\n",
    "    )\n",
    "    print(\n",
    "        \"    L'algorithme non supervisé (Isolation Forest) devra obligatoirement s'appuyer\"\n",
    "    )\n",
    "    print(\n",
    "        \"    sur des variables composites croisées pour capturer de réelles anomalies.\"\n",
    "    )\n",
    "\n",
    "# execution des fonctions\n",
    "plot_topological_isolation(df)\n",
    "plot_categorical_risk_distribution(df)\n",
    "plot_hourly_activity_by_channel(df)"
   ]
  },
