    "    print(f\"   Types : {'Aucun probleme' if len(type_issues) == 0 else f'{len(type_issues)} problemes detectes'}\")\n",
    "    \n",
    "    return audit_results\n",
    "\n",
    "audit_results = quality_audit(df)"
